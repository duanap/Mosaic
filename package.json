{
  "name": "djq",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "2-4 player polyomino strategy game with local and online play",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:browser": "node --test tests/browser_gameplay.mjs tests/browser_recovery.mjs tests/browser_layout.mjs",
    "benchmark:bots": "node scripts/benchmark-bots.mjs"
  }
}
