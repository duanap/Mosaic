# Optional: copy to .env and run: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
# For HTTPS reverse proxy, set the exact public origin without trailing slash:
# PUBLIC_ORIGIN=https://djq.example.com
# Enable only behind your trusted reverse proxy, which must overwrite X-Real-IP:
TRUST_PROXY=0
